<script>
// ---- Tabs: the settings are grouped by the markers in the form; only one group shows at a time.
document.addEventListener('DOMContentLoaded', function () {
  var form = document.querySelector('input[name="#file"][value="AuroraUnraid/AuroraUnraid.cfg"]');
  form = form && form.form;
  var first = document.querySelector('.tft-tab-marker');
  if (!form || !first) return;
  var lists = [Array.prototype.slice.call(form.children), []];
  for (var node = form.nextElementSibling; node; node = node.nextElementSibling) lists[1].push(node);
  var current = null, firstNode = null;
  lists.forEach(function (list) {
    list.forEach(function (node) {
      var marker = node.matches('.tft-tab-marker') ? node : node.querySelector('.tft-tab-marker');
      if (marker) {
        if (!firstNode && node.parentNode === form) firstNode = node;
        current = marker.dataset.tab === 'all' ? null : marker.dataset.tab;
        return;
      }
      if (current) node.dataset.tftTab = current;
    });
  });
  var tabs = [['appearance', 'Appearance'], ['layout', 'Header & sidebar'], ['quick', 'Quick Actions'], ['pages', 'Settings & Tools'], ['updates', 'Updates'], ['advanced', 'Advanced']];
  var bar = document.createElement('div');
  bar.className = 'tft-tabs';
  bar.setAttribute('role', 'tablist');
  var buttons = {};
  var show = function (id) {
    document.querySelectorAll('[data-tft-tab]').forEach(function (node) { node.classList.toggle('tft-tab-hidden', node.dataset.tftTab !== id); });
    Object.keys(buttons).forEach(function (key) {
      buttons[key].classList.toggle('tft-tab-on', key === id);
      buttons[key].setAttribute('aria-selected', key === id ? 'true' : 'false');
    });
    try { localStorage.setItem('auroraunraid.settingsTab', id); } catch (error) { /* private mode */ }
  };
  tabs.forEach(function (tab) {
    var button = document.createElement('button');
    button.type = 'button';
    button.className = 'tft-tab';
    button.setAttribute('role', 'tab');
    button.textContent = tab[1];
    button.addEventListener('click', function () { show(tab[0]); });
    buttons[tab[0]] = button;
    bar.append(button);
  });
  form.insertBefore(bar, firstNode || form.firstChild);
  var saved = null;
  try { saved = localStorage.getItem('auroraunraid.settingsTab'); } catch (error) { /* private mode */ }
  show(saved && buttons[saved] ? saved : 'appearance');
});
</script>

