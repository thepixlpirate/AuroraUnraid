<script>
// ---- Tabs and cards: the settings are grouped by the markers in the form into one card per tab,
// and a bar of tabs shows one card at a time.
document.addEventListener('DOMContentLoaded', function () {
  var field = document.querySelector('input[name="#file"][value="AuroraUnraid/AuroraUnraid.cfg"]');
  var form = field && field.form;
  if (!form || !document.querySelector('.tft-tab-marker')) return;
  var svg = function (body) { return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + body + '</svg>'; };
  var tabs = [
    ['appearance', 'Appearance', 'Colours, fonts and layout', svg('<path d="M12 3a9 9 0 1 0 0 18c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.2 0-1.1.9-2 2-2h2a4 4 0 0 0 4-4c0-4.4-4-8-9-8z"/><circle cx="7.5" cy="11" r=".8"/><circle cx="11" cy="7" r=".8"/><circle cx="16" cy="8" r=".8"/>')],
    ['layout', 'Header & sidebar', 'Top bar, sidebar, logo and footer', svg('<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>')],
    ['quick', 'Quick Actions', 'Show, hide and re-order the buttons', svg('<path d="M13 2 3 14h9l-1 8 10-12h-9z"/>')],
    ['pages', 'Settings & Tools', 'Hide tiles on those two pages', svg('<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>')],
    ['updates', 'Updates', 'Versions and automatic updates', svg('<path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"/><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"/><path d="M21 3v5h-5M3 21v-5h5"/>')],
    ['advanced', 'Advanced', 'Emergency switch', svg('<path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6z"/><path d="M12 8v5M12 16h.01"/>')]
  ];
  var meta = {};
  tabs.forEach(function (tab) { meta[tab[0]] = tab; });

  // One card per tab; the nodes between two markers move into it (their fields stay in the form).
  var panes = [];
  var group = function (list) {
    var pane = null;
    list.forEach(function (node) {
      var marker = node.matches('.tft-tab-marker') ? node : node.querySelector('.tft-tab-marker');
      if (marker) {
        pane = null;
        var id = marker.dataset.tab;
        if (id !== 'all' && meta[id]) {
          pane = document.createElement('section');
          pane.className = 'tft-pane';
          pane.dataset.tftTab = id;
          var head = document.createElement('header');
          head.className = 'tft-pane-head';
          var icon = document.createElement('span');
          icon.className = 'tft-pane-icon';
          icon.innerHTML = meta[id][3];
          var title = document.createElement('h2');
          title.textContent = meta[id][1];
          var sub = document.createElement('span');
          sub.className = 'tft-pane-sub';
          sub.textContent = meta[id][2];
          head.append(icon, title, sub);
          pane.append(head);
          node.parentNode.insertBefore(pane, node);
          panes.push(pane);
        }
        return;
      }
      if (pane) pane.append(node);
    });
  };
  var inside = Array.prototype.slice.call(form.children);
  var outside = [];
  for (var next = form.nextElementSibling; next; next = next.nextElementSibling) outside.push(next);
  var firstPane = null;
  group(inside);
  firstPane = panes[0];
  group(outside);

  var bar = document.createElement('nav');
  bar.className = 'tft-tabs';
  bar.setAttribute('role', 'tablist');
  var buttons = {};
  var show = function (id) {
    panes.forEach(function (pane) { pane.hidden = pane.dataset.tftTab !== id; });
    Object.keys(buttons).forEach(function (key) {
      buttons[key].classList.toggle('tft-tab-on', key === id);
      buttons[key].setAttribute('aria-selected', key === id ? 'true' : 'false');
    });
    try { localStorage.setItem('auroraunraid.settingsTab', id); } catch (error) { /* private mode */ }
  };
  tabs.forEach(function (tab) {
    var button = document.createElement('button');
    button.type = 'button';
    button.className = 'tft-tab';
    button.setAttribute('role', 'tab');
    button.innerHTML = '<span class="tft-tab-icon">' + tab[3] + '</span><span></span>';
    button.lastChild.textContent = tab[1];
    button.addEventListener('click', function () { show(tab[0]); });
    buttons[tab[0]] = button;
    bar.append(button);
  });
  form.insertBefore(bar, firstPane || form.firstChild);
  var saved = null;
  try { saved = localStorage.getItem('auroraunraid.settingsTab'); } catch (error) { /* private mode */ }
  show(saved && buttons[saved] ? saved : 'appearance');
});
</script>

