<script>
// The colour picker and the code field follow each other; changes are announced so that
// Unraid enables "Apply".
function auroraAccent(value) {
  var field = document.getElementById('tft-accent');
  field.value = value;
  if (/^#[0-9a-fA-F]{6}$/.test(value)) document.getElementById('tft-accent-pick').value = value;
  ['input', 'change'].forEach(function (type) { field.dispatchEvent(new Event(type, { bubbles: true })); });
  // Unraid only watches the fields that were on the page at the start; enable Apply ourselves.
  var apply = document.querySelector('input[name="#apply"]');
  if (apply) apply.disabled = false;
}
document.getElementById('tft-accent-pick').addEventListener('input', function () { auroraAccent(this.value); });
document.getElementById('tft-accent').addEventListener('input', function () {
  var code = this.value.trim().replace(/^#?/, '#');
  if (/^#[0-9a-fA-F]{3}$/.test(code)) code = '#' + code.slice(1).split('').map(function (c) { return c + c; }).join('');
  if (/^#[0-9a-fA-F]{6}$/.test(code)) document.getElementById('tft-accent-pick').value = code;
});
</script>

