<script>
// The weekday only for "Every week", the time for daily and weekly checks.
function auroraSchedule() {
  var when = document.getElementById('tft-when').value;
  document.getElementById('tft-day').hidden = when !== 'weekly';
  document.getElementById('tft-time').hidden = when === 'hourly';
}
auroraSchedule();
</script>

<script>
// ---- Unraid logo: the address and tab only for "my own address".
function auroraLogo() {
  var custom = document.getElementById('tft-logo-mode').value === 'custom';
  document.getElementById('tft-logo-url').hidden = !custom;
  document.getElementById('tft-logo-target').hidden = !custom;
}
auroraLogo();

// A change of a script-filled hidden field is announced so that Unraid enables "Apply".
function auroraAnnounce(field) {
  ['input', 'change'].forEach(function (type) { field.dispatchEvent(new Event(type, { bubbles: true })); });
}
function auroraSplit(value) {
  return String(value || '').split(',').map(function (part) { return part.trim(); }).filter(Boolean);
}

// ---- Quick Actions: a list read from the buttons of this page's menu.
var auroraQa = { rows: [], list: null };
function auroraQaSync() {
  var order = [], hidden = [];
  auroraQa.list.querySelectorAll('.tft-sort-row').forEach(function (row) {
    order.push(row.dataset.key);
    if (!row.querySelector('input[type=checkbox]').checked) hidden.push(row.dataset.key);
  });
  document.getElementById('tft-qa-order').value = order.join(',');
  document.getElementById('tft-qa-hidden').value = hidden.join(',');
  auroraAnnounce(document.getElementById('tft-qa-order'));
  auroraAnnounce(document.getElementById('tft-qa-hidden'));
}
function auroraQaBuild() {
  var tweaks = window.auroraTweaks;
  var list = document.getElementById('tft-qa');
  if (!tweaks) { list.textContent = 'The button list is not available (is the theme switched off for this browser?).'; return; }
  var saved = auroraSplit(document.getElementById('tft-qa-order').value);
  var hidden = auroraSplit(document.getElementById('tft-qa-hidden').value);
  var domKeys = [];
  var found = [];
  tweaks.quickItems().forEach(function (node) {
    var key = tweaks.quickKey(node);
    domKeys.push(key);
    var icon = tweaks.quickIcon(node);
    // Entries without an icon (Disk Viewer, Active Streams) are not buttons you can see.
    if (icon) found.push({ key: key, label: tweaks.quickLabel(node), icon: icon });
  });
  // Saved buttons that are not on this page right now stay in the list, so nothing is lost.
  saved.concat(hidden).forEach(function (key) {
    if (domKeys.indexOf(key) === -1 && !found.some(function (item) { return item.key === key; })) found.push({ key: key, label: key.replace(/^(href|text):/, ''), icon: null, absent: true });
  });
  found.sort(function (a, b) {
    var ia = saved.indexOf(a.key), ib = saved.indexOf(b.key);
    return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
  });
  list.className = 'tft-sortlist';
  list.replaceChildren();
  var dragging = null;
  found.forEach(function (item) {
    var row = document.createElement('div');
    row.className = 'tft-sort-row';
    row.dataset.key = item.key;
    var grip = document.createElement('span');
    grip.className = 'tft-grip';
    grip.title = 'Drag to move';
    grip.innerHTML = '<i class="fa fa-bars"></i>';
    var check = document.createElement('input');
    check.type = 'checkbox';
    check.checked = hidden.indexOf(item.key) === -1;
    check.addEventListener('change', auroraQaSync);
    var icon = document.createElement('span');
    icon.className = 'tft-sort-icon';
    if (item.icon) icon.append(item.icon);
    var label = document.createElement('span');
    label.className = 'tft-sort-label';
    label.textContent = item.label + (item.absent ? ' (not on this page)' : '');
    var up = document.createElement('button'), down = document.createElement('button');
    up.type = down.type = 'button';
    up.className = down.className = 'tft-move';
    up.title = 'Move up'; down.title = 'Move down';
    up.innerHTML = '<i class="fa fa-arrow-up"></i>'; down.innerHTML = '<i class="fa fa-arrow-down"></i>';
    up.addEventListener('click', function () { if (row.previousElementSibling) { list.insertBefore(row, row.previousElementSibling); auroraQaSync(); } });
    down.addEventListener('click', function () { if (row.nextElementSibling) { list.insertBefore(row.nextElementSibling, row); auroraQaSync(); } });
    grip.addEventListener('mousedown', function () { row.draggable = true; });
    row.addEventListener('dragstart', function (event) {
      dragging = row;
      row.classList.add('tft-dragging');
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData('text/plain', item.key);
    });
    row.addEventListener('dragend', function () {
      row.draggable = false;
      row.classList.remove('tft-dragging');
      dragging = null;
      auroraQaSync();
    });
    row.append(grip, check, icon, label, up, down);
    list.append(row);
  });
  list.ondragover = function (event) {
    if (!dragging) return;
    event.preventDefault();
    var after = null, best = Number.NEGATIVE_INFINITY;
    list.querySelectorAll('.tft-sort-row:not(.tft-dragging)').forEach(function (row) {
      var box = row.getBoundingClientRect();
      var offset = event.clientY - box.top - box.height / 2;
      if (offset < 0 && offset > best) { best = offset; after = row; }
    });
    if (after) list.insertBefore(dragging, after); else list.append(dragging);
  };
}
function auroraQaReset() {
  document.getElementById('tft-qa-order').value = '';
  document.getElementById('tft-qa-hidden').value = '';
  auroraAnnounce(document.getElementById('tft-qa-order'));
  auroraAnnounce(document.getElementById('tft-qa-hidden'));
  auroraQaBuild();
}

// ---- Settings and Tools tiles: a checkbox per tile of that page, read from the page itself,
// and one per category that switches all of its tiles (and the category's title) at once.
function auroraPanels(kind, fieldId, boxId) {
  var field = document.getElementById(fieldId);
  var box = document.getElementById(boxId);
  var hidden = auroraSplit(field.value);
  var sync = function () {
    var now = [];
    box.querySelectorAll('input[data-key]').forEach(function (check) { if (!check.checked) now.push(check.dataset.key); });
    // Tiles that are not on the page any more keep their saved choice.
    hidden.forEach(function (key) { if (!box.querySelector('input[data-key="' + key + '"]') && now.indexOf(key) === -1) now.push(key); });
    field.value = now.join(',');
    auroraAnnounce(field);
  };
  var tweaks = window.auroraTweaks;
  if (!tweaks) { box.textContent = 'The tile list is not available (is the theme switched off for this browser?).'; return; }
  tweaks.fetchPanels(kind).then(function (panels) {
    box.replaceChildren();
    if (!panels.length) { box.textContent = 'No tiles found on the ' + kind + ' page.'; return; }
    var section = null, grid = null, current = null;
    var refresh = function (entry) {
      if (!entry.head) return;
      var on = entry.checks.filter(function (check) { return check.checked; }).length;
      entry.head.checked = on === entry.checks.length;
      entry.head.indeterminate = on > 0 && on < entry.checks.length;
    };
    var all = [];
    panels.forEach(function (panel) {
      if (current === null || panel.section !== section) {
        section = panel.section;
        current = { head: null, checks: [] };
        all.push(current);
        if (section) {
          var title = document.createElement('label');
          title.className = 'tft-panels-heading';
          var head = document.createElement('input');
          head.type = 'checkbox';
          head.title = 'Show or hide the whole category';
          current.head = head;
          head.addEventListener('change', (function (entry) {
            return function () {
              entry.checks.forEach(function (check) { check.checked = entry.head.checked; });
              entry.head.indeterminate = false;
              sync();
            };
          })(current));
          title.append(head, document.createTextNode(' ' + section));
          box.append(title);
        }
        grid = document.createElement('div');
        grid.className = 'tft-toggles';
        box.append(grid);
      }
      var label = document.createElement('label');
      label.className = 'tft-check tft-check-inline';
      var check = document.createElement('input');
      check.type = 'checkbox';
      check.dataset.key = panel.key;
      check.checked = hidden.indexOf(panel.key) === -1;
      check.addEventListener('change', (function (entry) { return function () { refresh(entry); sync(); }; })(current));
      current.checks.push(check);
      label.append(check, document.createTextNode(' ' + panel.label));
      grid.append(label);
    });
    all.forEach(refresh);
  }).catch(function () { box.textContent = 'The ' + kind + ' page could not be read.'; });
}

// The Quick Actions are drawn by the theme's script after the page is parsed; wait for it.
document.addEventListener('DOMContentLoaded', function () {
  var tries = 0;
  (function wait() {
    if (window.auroraTweaks || tries++ > 40) {
      auroraQaBuild();
      auroraPanels('Settings', 'tft-hide-settings', 'tft-panels-settings');
      auroraPanels('Tools', 'tft-hide-tools', 'tft-panels-tools');
    } else setTimeout(wait, 100);
  })();
});
</script>

