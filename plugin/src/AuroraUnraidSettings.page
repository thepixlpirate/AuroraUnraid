<script>
// The weekday only for "Every week", the time for daily and weekly checks.
function auroraSchedule() {
  var when = document.getElementById('tft-when').value;
  document.getElementById('tft-day').hidden = when !== 'weekly';
  document.getElementById('tft-time').hidden = when === 'hourly';
}
auroraSchedule();
</script>

<script>
// ---- Unraid logo: the address and tab only for "my own address".
function auroraLogo() {
  var custom = document.getElementById('tft-logo-mode').value === 'custom';
  document.getElementById('tft-logo-url').hidden = !custom;
  document.getElementById('tft-logo-target').hidden = !custom;
}
auroraLogo();

// A change of a script-filled hidden field is announced so that Unraid enables "Apply".
function auroraAnnounce(field) {
  ['input', 'change'].forEach(function (type) { field.dispatchEvent(new Event(type, { bubbles: true })); });
  // Unraid only wires up the fields that exist when the page loads, so the checkboxes made by
  // this script do not enable "Apply" by themselves.
  document.querySelectorAll('input[value="Apply"], input[name="#apply"]').forEach(function (button) { button.disabled = false; });
}
function auroraSplit(value) {
  return String(value || '').split(',').map(function (part) { return part.trim(); }).filter(Boolean);
}

// ---- Quick Actions: a list read from the buttons of this page's menu.
var auroraQa = { rows: [], list: null };
function auroraQaSync() {
  var order = [], hidden = [];
  auroraQa.list.querySelectorAll('.tft-sort-row').forEach(function (row) {
    order.push(row.dataset.key);
    if (!row.querySelector('input[type=checkbox]').checked) hidden.push(row.dataset.key);
  });
  document.getElementById('tft-qa-order').value = order.join(',');
  document.getElementById('tft-qa-hidden').value = hidden.join(',');
  auroraAnnounce(document.getElementById('tft-qa-order'));
  auroraAnnounce(document.getElementById('tft-qa-hidden'));
}
function auroraQaBuild() {
  var tweaks = window.auroraTweaks;
  var list = document.getElementById('tft-qa');
  if (!tweaks) { list.textContent = 'The button list is not available (is the theme switched off for this browser?).'; return; }
  var saved = auroraSplit(document.getElementById('tft-qa-order').value);
  var hidden = auroraSplit(document.getElementById('tft-qa-hidden').value);
  var domKeys = [];
  var found = [];
  tweaks.quickItems().forEach(function (node) {
    var key = tweaks.quickKey(node);
    domKeys.push(key);
    // Entries nobody sees in the menu (Disk Viewer, Active Streams) are left out.
    if (!tweaks.quickShown(node)) return;
    found.push({ key: key, label: tweaks.quickLabel(node), icon: tweaks.quickIcon(node) });
  });
  // The lock button is only in the menu of the Dashboard.
  if (domKeys.indexOf('LockButton') === -1) found.push({ key: 'LockButton', label: 'Lock / unlock sortable items', icon: null, note: ' (Dashboard only)' });
  // Saved buttons that are not on this page right now stay in the list, so nothing is lost.
  saved.concat(hidden).forEach(function (key) {
    if (domKeys.indexOf(key) === -1 && !found.some(function (item) { return item.key === key; })) found.push({ key: key, label: key.replace(/^(href|text):/, ''), icon: null, note: ' (not on this page)' });
  });
  found.sort(function (a, b) {
    var ia = saved.indexOf(a.key), ib = saved.indexOf(b.key);
    return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
  });
  auroraQa.list = list;
  list.className = 'tft-sortlist';
  list.replaceChildren();
  var dragging = null;
  found.forEach(function (item) {
    var row = document.createElement('div');
    row.className = 'tft-sort-row';
    row.dataset.key = item.key;
    var grip = document.createElement('span');
    grip.className = 'tft-grip';
    grip.title = 'Drag to move';
    grip.innerHTML = '<i class="fa fa-bars"></i>';
    var check = document.createElement('input');
    check.type = 'checkbox';
    check.checked = hidden.indexOf(item.key) === -1;
    check.addEventListener('change', auroraQaSync);
    var icon = document.createElement('span');
    icon.className = 'tft-sort-icon';
    if (item.icon) icon.append(item.icon);
    var label = document.createElement('span');
    label.className = 'tft-sort-label';
    label.textContent = item.label + (item.note || '');
    var up = document.createElement('button'), down = document.createElement('button');
    up.type = down.type = 'button';
    up.className = down.className = 'tft-move';
    up.title = 'Move up'; down.title = 'Move down';
    up.innerHTML = '<i class="fa fa-arrow-up"></i>'; down.innerHTML = '<i class="fa fa-arrow-down"></i>';
    up.addEventListener('click', function () { if (row.previousElementSibling) { list.insertBefore(row, row.previousElementSibling); auroraQaSync(); } });
    down.addEventListener('click', function () { if (row.nextElementSibling) { list.insertBefore(row.nextElementSibling, row); auroraQaSync(); } });
    grip.addEventListener('mousedown', function () { row.draggable = true; });
    row.addEventListener('dragstart', function (event) {
      dragging = row;
      row.classList.add('tft-dragging');
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData('text/plain', item.key);
    });
    row.addEventListener('dragend', function () {
      row.draggable = false;
      row.classList.remove('tft-dragging');
      dragging = null;
      auroraQaSync();
    });
    row.append(grip, check, icon, label, up, down);
    list.append(row);
  });
  list.ondragover = function (event) {
    if (!dragging) return;
    event.preventDefault();
    // The list is a grid: the row nearest to the pointer decides, and the dragged row goes before
    // or after it depending on which side of that row's middle the pointer is.
    var nearest = null, best = Number.POSITIVE_INFINITY;
    list.querySelectorAll('.tft-sort-row:not(.tft-dragging)').forEach(function (row) {
      var box = row.getBoundingClientRect();
      var dx = event.clientX - (box.left + box.width / 2), dy = event.clientY - (box.top + box.height / 2);
      var distance = dx * dx + dy * dy;
      if (distance < best) { best = distance; nearest = row; }
    });
    if (!nearest) return;
    var box = nearest.getBoundingClientRect();
    var sameRow = event.clientY >= box.top && event.clientY <= box.bottom;
    var before = sameRow ? event.clientX < box.left + box.width / 2 : event.clientY < box.top;
    if (before) list.insertBefore(dragging, nearest); else list.insertBefore(dragging, nearest.nextSibling);
  };
}
function auroraQaReset() {
  document.getElementById('tft-qa-order').value = '';
  document.getElementById('tft-qa-hidden').value = '';
  auroraAnnounce(document.getElementById('tft-qa-order'));
  auroraAnnounce(document.getElementById('tft-qa-hidden'));
  auroraQaBuild();
}

// ---- Settings and Tools tiles: a card per tile of those two pages (read from the pages themselves,
// with Unraid's own icons) and a switch on it, one switch per category, a filter and "all on / all off".
function auroraTiles() {
  var box = document.getElementById('tft-tiles');
  var fields = { Settings: document.getElementById('tft-hide-settings'), Tools: document.getElementById('tft-hide-tools') };
  var tweaks = window.auroraTweaks;
  if (!tweaks) { box.textContent = 'The tile list is not available (is the theme switched off for this browser?).'; return; }
  var hidden = { Settings: auroraSplit(fields.Settings.value), Tools: auroraSplit(fields.Tools.value) };
  var sync = function () {
    ['Settings', 'Tools'].forEach(function (kind) {
      var now = [];
      box.querySelectorAll('input[data-kind="' + kind + '"]').forEach(function (check) { if (!check.checked) now.push(check.dataset.key); });
      // Tiles that are not on the page any more keep their saved choice.
      hidden[kind].forEach(function (key) { if (!box.querySelector('input[data-key="' + key + '"]') && now.indexOf(key) === -1) now.push(key); });
      fields[kind].value = now.join(',');
      auroraAnnounce(fields[kind]);
    });
  };
  Promise.all([tweaks.fetchPanels('Settings'), tweaks.fetchPanels('Tools')]).then(function (lists) {
    box.replaceChildren();
    var kinds = ['Settings', 'Tools'];
    var filter = { kind: 'all', text: '' };
    var groups = [];

    // Toolbar
    var bar = document.createElement('div');
    bar.className = 'tft-tilebar';
    var segment = document.createElement('div');
    segment.className = 'tft-segment';
    var segButtons = {};
    [['all', 'All tiles'], ['Settings', 'Settings tiles'], ['Tools', 'Tools tiles']].forEach(function (item) {
      var button = document.createElement('button');
      button.type = 'button';
      button.textContent = item[1];
      button.addEventListener('click', function () { filter.kind = item[0]; apply(); });
      segButtons[item[0]] = button;
      segment.append(button);
    });
    var search = document.createElement('input');
    search.type = 'search';
    search.placeholder = 'Filter tiles...';
    search.className = 'tft-tilesearch';
    search.addEventListener('input', function () { filter.text = search.value.trim().toLowerCase(); apply(); });
    var setAll = function (on) {
      groups.forEach(function (group) {
        if (group.element.hidden) return;
        group.tiles.forEach(function (tile) { if (!tile.element.hidden) tile.check.checked = on; });
        refresh(group);
      });
      sync();
    };
    var allOn = document.createElement('button');
    var allOff = document.createElement('button');
    allOn.type = allOff.type = 'button';
    allOn.className = allOff.className = 'tft-mini';
    allOn.textContent = 'All on';
    allOff.textContent = 'All off';
    allOn.title = 'Show every tile that is listed';
    allOff.title = 'Hide every tile that is listed';
    allOn.addEventListener('click', function () { setAll(true); });
    allOff.addEventListener('click', function () { setAll(false); });
    bar.append(segment, search, allOn, allOff);
    box.append(bar);

    var refresh = function (group) {
      var on = group.tiles.filter(function (tile) { return tile.check.checked; }).length;
      group.head.checked = on === group.tiles.length;
      group.head.indeterminate = on > 0 && on < group.tiles.length;
    };
    var apply = function () {
      Object.keys(segButtons).forEach(function (key) { segButtons[key].classList.toggle('tft-on', key === filter.kind); });
      groups.forEach(function (group) {
        var shown = 0;
        group.tiles.forEach(function (tile) {
          var visible = (filter.kind === 'all' || filter.kind === group.kind) && (!filter.text || tile.label.toLowerCase().indexOf(filter.text) !== -1);
          tile.element.hidden = !visible;
          if (visible) shown++;
        });
        group.element.hidden = shown === 0;
      });
    };

    kinds.forEach(function (kind, index) {
      var section = null, group = null, grid = null;
      lists[index].forEach(function (panel) {
        if (!group || panel.section !== section) {
          section = panel.section;
          var wrap = document.createElement('div');
          wrap.className = 'tft-tilegroup';
          var title = document.createElement('label');
          title.className = 'tft-tilegroup-head';
          var head = document.createElement('input');
          head.type = 'checkbox';
          head.title = 'Switch the whole category on or off';
          var name = document.createElement('span');
          name.className = 'tft-tilegroup-name';
          name.textContent = section || kind;
          var tag = document.createElement('span');
          tag.className = 'tft-tilegroup-kind';
          tag.textContent = kind + ' page';
          title.append(head, name, tag);
          grid = document.createElement('div');
          grid.className = 'tft-tilegrid';
          wrap.append(title, grid);
          box.append(wrap);
          group = { kind: kind, element: wrap, head: head, tiles: [] };
          groups.push(group);
          head.addEventListener('change', (function (entry) {
            return function () {
              entry.tiles.forEach(function (tile) { tile.check.checked = entry.head.checked; });
              entry.head.indeterminate = false;
              sync();
            };
          })(group));
        }
        var tile = document.createElement('label');
        tile.className = 'tft-tile';
        var icon = document.createElement('span');
        icon.className = 'tft-tile-icon';
        if (panel.icon) icon.append(panel.icon);
        var label = document.createElement('span');
        label.className = 'tft-tile-name';
        label.textContent = panel.label;
        var check = document.createElement('input');
        check.type = 'checkbox';
        check.dataset.key = panel.key;
        check.dataset.kind = kind;
        check.checked = hidden[kind].indexOf(panel.key) === -1;
        check.addEventListener('change', (function (entry) { return function () { refresh(entry); sync(); }; })(group));
        tile.append(icon, label, check);
        grid.append(tile);
        group.tiles.push({ element: tile, check: check, label: panel.label });
      });
    });
    groups.forEach(refresh);
    apply();
  }).catch(function () { box.textContent = 'The Settings and Tools pages could not be read.'; });
}

// The Quick Actions are drawn by the theme's script after the page is parsed; wait for it.
document.addEventListener('DOMContentLoaded', function () {
  var tries = 0;
  (function wait() {
    if (window.auroraTweaks || tries++ > 40) {
      auroraQaBuild();
      auroraTiles();
    } else setTimeout(wait, 100);
  })();
});
</script>

